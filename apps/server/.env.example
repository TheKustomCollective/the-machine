# Database Configuration
# For local development with Docker: postgresql://postgres:postgres@localhost:5432/themachine
# For production: use your cloud database URL
DATABASE_URL="postgresql://user:password@localhost:5432/themachine"

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT Configuration
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRATION="7d"

# CORS Configuration
# For development: "*" allows all origins
# For production: specify your mobile app's origin
CORS_ORIGIN="*"

# AI Configuration (Optional)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"
AI_MODEL="gpt-3.5-turbo"

# Logging
LOG_LEVEL="info"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=60000
